# Supabase (shared Neuvetra project — same project as FrontDesk).
# Get these values from the Supabase dashboard: Project Settings → API.
# The same project URL + anon key go on the api side too (as
# SUPABASE_URL / SUPABASE_ANON_KEY in apps/api/.env).
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
