# Supabase (shared Neuvetra project — same project as FrontDesk).
# Copy to apps/site-web/.env. The homepage can be previewed without auth.
# Get these public values from Supabase: Project Settings → API.
# Use the same URL/key as SUPABASE_URL / SUPABASE_ANON_KEY in apps/site-api/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development uses /api -> localhost:3001. Set the public API URL
# at build time for production; never place service-role keys in VITE_* values.
VITE_API_URL=
