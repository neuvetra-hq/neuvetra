# Copy this file to .env.local and fill in the values
# Never commit .env.local to git

PORT=3000

# Supabase
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://api.neuvetra.com
TWILIO_MESSAGE_SERVICE_SID=
# Twilio Voice (browser click-to-call) — create at console.twilio.com
# TwiML App: Voice Request URL = https://api.neuvetra.com/voice/outbound
# API Key: create Standard key, copy SID + Secret
TWILIO_TWIML_APP_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=

# Retell AI
RETELL_API_KEY=
RETELL_AGENT_ID=
# Neuvetra demo agent (run scripts/deploy-neuvetra-agent.ts to get the agent ID)
NEUVETRA_AGENT_ID=
NEUVETRA_NOTIFY_PHONE=   # Nima's personal cell for lead SMS notifications (E.164, e.g. +14155551234)

# Google Calendar OAuth
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Calendar API
# Redirect URI must be added to the OAuth client: https://api.neuvetra.com/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.neuvetra.com/calendar/callback

# Frontend URL (used to redirect after OAuth callback)
WEB_URL=https://neuvetra.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_METER_EVENT_NAME=front_desk_minutes
STRIPE_PRICE_STARTER_FLAT=price_...
STRIPE_PRICE_STARTER_METERED=price_...
STRIPE_PRICE_GROWTH_FLAT=price_...
STRIPE_PRICE_GROWTH_METERED=price_...
STRIPE_PRICE_PRO_FLAT=price_...
STRIPE_PRICE_PRO_METERED=price_...
