# Dedicated combined M63 image. Build from the repository root with this file;
# Dockerfile.staging.dockerignore is the matching deny-by-default context filter.
# This does not alter the ordinary Site/FrontDesk Dockerfiles or enable flags.
FROM oven/bun:1.3.12 AS workspace
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/frontdesk-api/package.json ./apps/frontdesk-api/
COPY apps/frontdesk-web/package.json ./apps/frontdesk-web/
COPY apps/site-api/package.json ./apps/site-api/
COPY apps/site-web/package.json ./apps/site-web/
COPY apps/terrascope-api/package.json ./apps/terrascope-api/
COPY apps/terrascope-web/package.json ./apps/terrascope-web/
COPY packages/frontdesk-config/package.json ./packages/frontdesk-config/
COPY packages/frontdesk-database/package.json ./packages/frontdesk-database/
COPY packages/neuvetra-database/package.json ./packages/neuvetra-database/
COPY packages/terrascope-config/package.json ./packages/terrascope-config/
COPY packages/terrascope-database/package.json ./packages/terrascope-database/
COPY packages/terrascope-calculator/package.json ./packages/terrascope-calculator/

FROM workspace AS web-build
RUN bun install --frozen-lockfile --filter site-web
COPY tsconfig.base.json ./
COPY config/typescript/ ./config/typescript/
COPY apps/site-web/tsconfig.json apps/site-web/tsconfig.app.json apps/site-web/tsconfig.node.json apps/site-web/vite.config.ts apps/site-web/vite.staging.config.ts apps/site-web/staging.html ./apps/site-web/
COPY apps/site-web/scripts/finalize-staging.ts ./apps/site-web/scripts/
COPY apps/site-web/src/ ./apps/site-web/src/
COPY packages/neuvetra-database/src/m64-contract.ts packages/neuvetra-database/src/m65-contract.ts packages/neuvetra-database/src/m65-template.ts packages/neuvetra-database/src/m66-contract.ts packages/neuvetra-database/src/m66-template.ts packages/neuvetra-database/src/m66-fixtures.ts packages/neuvetra-database/src/m67-contract.ts packages/neuvetra-database/src/m67-template.ts packages/neuvetra-database/src/m68-contract.ts packages/neuvetra-database/src/m68-template.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m71-contract.ts packages/neuvetra-database/src/m71-validation.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m73-contract.ts packages/neuvetra-database/src/m73-validation.ts packages/neuvetra-database/src/m73-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m74-contract.ts packages/neuvetra-database/src/m74-validation.ts packages/neuvetra-database/src/m74-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m75-contract.ts packages/neuvetra-database/src/m75-validation.ts packages/neuvetra-database/src/m75-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m76-contract.ts packages/neuvetra-database/src/m76-validation.ts packages/neuvetra-database/src/m76-report.ts packages/neuvetra-database/src/m76-diesel-contract.ts packages/neuvetra-database/src/m76-diesel-validation.ts packages/neuvetra-database/src/m76-diesel-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m77-contract.ts packages/neuvetra-database/src/m77-validation.ts packages/neuvetra-database/src/m77-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m78-contract.ts packages/neuvetra-database/src/m78-validation.ts packages/neuvetra-database/src/m78-reconciliation.ts packages/neuvetra-database/src/m78-policy.ts packages/neuvetra-database/src/m78-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m80-contract.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/company-setup-contract.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/collection-contract.ts packages/neuvetra-database/src/collection-engine-input.ts packages/neuvetra-database/src/collection-duplicates.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/scope3-collection-contract.ts packages/neuvetra-database/src/scope3-collection.ts packages/neuvetra-database/src/scope3-coverage.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-01: the method catalog and texts that scope3-coverage.ts re-exports.
# Scope 3 completion I-02: the assessment contract (scope3-text.ts is copied once, above).
COPY packages/neuvetra-database/src/scope3-method-catalog.ts packages/neuvetra-database/src/scope3-text.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/scope3-assessment-contract.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-04: the provisional SB 253 Scope 3 deadline (setup and results screens).
COPY packages/neuvetra-database/src/scope3-deadline.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-06: the results v2 trace, methodology and shared CSV modules (the results screen and decoder).
COPY packages/neuvetra-database/src/scope3-trace.ts packages/neuvetra-database/src/scope3-methodology.ts packages/neuvetra-database/src/scope3-report-csv.ts ./packages/neuvetra-database/src/
# Round 2 lane E (ENG-6): the plain-language labels the web re-exports (moved from apps/site-web/src/lib/plain-language.ts).
COPY packages/neuvetra-database/src/plain-language-labels.ts packages/neuvetra-database/src/scope3-text-r2e.ts ./packages/neuvetra-database/src/
# Round 3 lane A: the shared memo, partial-boundary and superseded-spend helpers (coverage, methodology, CSV, trace, screen).
COPY packages/neuvetra-database/src/scope3-r3a.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-09: the shared spend CSV parser (import panel preview and the CSV Mapping section).
COPY packages/neuvetra-database/src/scope3-spend-import.ts packages/neuvetra-database/src/scope3-spend-grouping.ts packages/neuvetra-database/src/scope3-spend-currency.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-10: the frozen report document (the report-version panel decodes stored versions with it).
COPY packages/neuvetra-database/src/scope3-report-document.ts ./packages/neuvetra-database/src/
# Round 2 (lane B): the frozen report validators the document module imports (owner decision 11).
COPY packages/neuvetra-database/src/scope3-report-v1.ts packages/neuvetra-database/src/scope3-report-v2.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/scope3-report-v3.ts packages/neuvetra-database/src/scope3-text-v3.ts ./packages/neuvetra-database/src/
# Full web typechecking resolves this reviewed catalog; it is not a runtime corpus.
COPY data/research/answer-units/scope2-website.epa-acquisition.v1.json ./data/research/answer-units/
COPY output/pdf/neuvetra-m55-synthetic-electricity-bill.pdf output/pdf/neuvetra-m66-synthetic-electricity-bill-b.pdf ./output/pdf/
RUN bun run --filter site-web build:staging

FROM workspace AS production-dependencies
RUN bun install --frozen-lockfile --production --filter site-api

FROM python:3.12.11-slim-bookworm AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080 \
    NEUVETRA_PYTHON=/usr/local/bin/python \
    NEUVETRA_STAGING_WEB_ROOT=/app/apps/site-web/dist-staging \
    NEUVETRA_STAGING_DB_CA_FILE=/app/tools/cloud/fixtures/supabase-prod-ca-2021.crt \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY --from=workspace /usr/local/bin/bun /usr/local/bin/bun
COPY --from=production-dependencies /app/ ./
COPY tsconfig.base.json ./
COPY config/typescript/ ./config/typescript/
COPY apps/site-api/tsconfig.json ./apps/site-api/
COPY apps/site-api/src/staging/server.ts apps/site-api/src/staging/config.ts apps/site-api/src/staging/assets.ts ./apps/site-api/src/staging/
COPY apps/site-api/src/workspace/service.ts apps/site-api/src/workspace/routes.ts apps/site-api/src/workspace/types.ts apps/site-api/src/workspace/synthetic-bill-parser.ts apps/site-api/src/workspace/m64-routes.ts apps/site-api/src/workspace/m65-routes.ts apps/site-api/src/workspace/m66-routes.ts apps/site-api/src/workspace/m66-source-routes.ts apps/site-api/src/workspace/m66-report-routes.ts apps/site-api/src/workspace/m67-routes.ts apps/site-api/src/workspace/m67-report-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/lib/auth.ts apps/site-api/src/lib/origin-check.ts apps/site-api/src/lib/rate-limit.ts ./apps/site-api/src/lib/
COPY apps/site-api/src/calculation/server.ts apps/site-api/src/calculation/linked_bill_calculation.py apps/site-api/src/calculation/location_based_electricity.py ./apps/site-api/src/calculation/
COPY packages/neuvetra-database/src/index.ts packages/neuvetra-database/src/workspace.ts packages/neuvetra-database/src/hosted.ts packages/neuvetra-database/src/staging-migrations.ts packages/neuvetra-database/src/staging-audit.ts packages/neuvetra-database/src/staging-tls.ts packages/neuvetra-database/src/m58.ts packages/neuvetra-database/src/m59.ts packages/neuvetra-database/src/m60.ts packages/neuvetra-database/src/m61.ts packages/neuvetra-database/src/m64.ts packages/neuvetra-database/src/m64-contract.ts packages/neuvetra-database/src/m65.ts packages/neuvetra-database/src/m65-contract.ts packages/neuvetra-database/src/m65-template.ts packages/neuvetra-database/src/m66-contract.ts packages/neuvetra-database/src/m66-template.ts packages/neuvetra-database/src/m66-fixtures.ts packages/neuvetra-database/src/m67-contract.ts packages/neuvetra-database/src/m67-template.ts packages/neuvetra-database/src/m68-contract.ts packages/neuvetra-database/src/m68-template.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m68.ts packages/neuvetra-database/src/m68-contract.ts packages/neuvetra-database/src/m68-template.ts packages/neuvetra-database/src/m68-report.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/m68-routes.ts apps/site-api/src/workspace/m68-report-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/workspace/m71-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/workspace/m73-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/calculation/m73-authority.ts apps/site-api/src/calculation/m73_stationary_natural_gas.py apps/site-api/src/calculation/stationary_natural_gas.py ./apps/site-api/src/calculation/
COPY packages/neuvetra-database/src/m73.ts packages/neuvetra-database/src/m73-contract.ts packages/neuvetra-database/src/m73-validation.ts packages/neuvetra-database/src/m73-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/migrations/0016_stationary_natural_gas.sql ./packages/neuvetra-database/src/migrations/
COPY apps/site-api/src/workspace/m74-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/calculation/m74-authority.ts apps/site-api/src/calculation/m74_mobile_diesel.py ./apps/site-api/src/calculation/
COPY packages/neuvetra-database/src/m74.ts packages/neuvetra-database/src/m74-contract.ts packages/neuvetra-database/src/m74-validation.ts packages/neuvetra-database/src/m74-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/migrations/0017_mobile_diesel.sql ./packages/neuvetra-database/src/migrations/
COPY packages/neuvetra-database/src/m71.ts packages/neuvetra-database/src/m71-contract.ts packages/neuvetra-database/src/m71-validation.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/migrations/0015_corporate_coverage.sql ./packages/neuvetra-database/src/migrations/
COPY packages/neuvetra-database/src/m67.ts packages/neuvetra-database/src/m67-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m66.ts packages/neuvetra-database/src/m66-sources.ts packages/neuvetra-database/src/m66-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/migrations/0001_company_workspace.sql packages/neuvetra-database/src/migrations/0002_synthetic_bill_intake.sql packages/neuvetra-database/src/migrations/0003_synthetic_bill_calculation.sql packages/neuvetra-database/src/migrations/0004_inventory_review.sql packages/neuvetra-database/src/migrations/0005_annual_electricity_register.sql packages/neuvetra-database/src/migrations/0006_inventory_evidence_pack.sql packages/neuvetra-database/src/migrations/0007_inventory_draft_report.sql packages/neuvetra-database/src/migrations/0008_inventory_draft_report_review.sql packages/neuvetra-database/src/migrations/0009_private_staging.sql packages/neuvetra-database/src/migrations/0010_manual_electricity_worksheet.sql packages/neuvetra-database/src/migrations/0011_worksheet_reports.sql packages/neuvetra-database/src/migrations/0012_source_electricity_worksheet.sql packages/neuvetra-database/src/migrations/0013_annual_electricity_worksheet.sql packages/neuvetra-database/src/migrations/0014_annual_electricity_evidence.sql ./packages/neuvetra-database/src/migrations/
COPY output/pdf/neuvetra-m55-synthetic-electricity-bill.pdf output/pdf/neuvetra-m66-synthetic-electricity-bill-b.pdf ./output/pdf/
COPY data/synthetic/m58-electricity-register-2023.json data/synthetic/m58-electricity-register-2023.manifest.json ./data/synthetic/
COPY tools/cloud/fixtures/supabase-prod-ca-2021.crt ./tools/cloud/fixtures/
COPY --from=web-build /app/apps/site-web/dist-staging/ ./apps/site-web/dist-staging/
COPY apps/site-api/src/workspace/m75-routes.ts ./apps/site-api/src/workspace/
COPY packages/neuvetra-database/src/m75.ts packages/neuvetra-database/src/m75-contract.ts packages/neuvetra-database/src/m75-validation.ts packages/neuvetra-database/src/m75-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/migrations/0018_controlled_fleet.sql ./packages/neuvetra-database/src/migrations/
COPY packages/neuvetra-database/src/m76-contract.ts packages/neuvetra-database/src/m76-validation.ts packages/neuvetra-database/src/m76-report.ts packages/neuvetra-database/src/m76-diesel-contract.ts packages/neuvetra-database/src/m76-diesel-validation.ts packages/neuvetra-database/src/m76-diesel-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m76.ts packages/neuvetra-database/src/m76-diesel.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/m76-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/calculation/m76-authority.ts apps/site-api/src/calculation/m76_stationary_diesel.py ./apps/site-api/src/calculation/
COPY packages/neuvetra-database/src/migrations/0019_stationary_sources.sql ./packages/neuvetra-database/src/migrations/
COPY packages/neuvetra-database/src/m77-contract.ts packages/neuvetra-database/src/m77-validation.ts packages/neuvetra-database/src/m77-report.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/m77.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/m77-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/calculation/m77-authority.ts apps/site-api/src/calculation/m77_fugitive.py ./apps/site-api/src/calculation/
COPY packages/neuvetra-database/src/migrations/0020_fugitive_sources.sql ./packages/neuvetra-database/src/migrations/
COPY tools/staging/m77-image-smoke.ts ./tools/staging/
COPY packages/neuvetra-database/src/m78.ts packages/neuvetra-database/src/m78-contract.ts packages/neuvetra-database/src/m78-validation.ts packages/neuvetra-database/src/m78-reconciliation.ts packages/neuvetra-database/src/m78-policy.ts packages/neuvetra-database/src/m78-report.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/m78-routes.ts ./apps/site-api/src/workspace/
COPY packages/neuvetra-database/src/migrations/0021_scope1_inventory.sql ./packages/neuvetra-database/src/migrations/
COPY packages/neuvetra-database/src/m80.ts packages/neuvetra-database/src/m80-contract.ts packages/neuvetra-database/src/m80-fixture.ts packages/neuvetra-database/src/m80-validation.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/m80-beta-routes.ts ./apps/site-api/src/workspace/
COPY packages/neuvetra-database/src/migrations/0022_scope1_beta_foundation.sql ./packages/neuvetra-database/src/migrations/
COPY packages/neuvetra-database/src/company-setup.ts packages/neuvetra-database/src/company-setup-contract.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/company-setup-routes.ts ./apps/site-api/src/workspace/
COPY packages/neuvetra-database/src/migrations/0023_company_setup.sql ./packages/neuvetra-database/src/migrations/
# Collection and reviewed method sources are copied as inert files; the hosted
# migration manifest and method release state remain separate operational gates.
COPY apps/site-api/src/workspace/collection-routes.ts apps/site-api/src/workspace/collection-storage.ts apps/site-api/src/workspace/collection-zip.ts apps/site-api/src/workspace/collection-results-routes.ts apps/site-api/src/workspace/scope3-results-routes.ts ./apps/site-api/src/workspace/
COPY apps/site-api/src/calculation/method-engine-runner.ts apps/site-api/src/calculation/scope1-authority.ts apps/site-api/src/calculation/scope2-authority.ts apps/site-api/src/calculation/scope3-authority.ts ./apps/site-api/src/calculation/
COPY apps/site-api/src/calculation/scope1_engine.py apps/site-api/src/calculation/scope2_engine.py apps/site-api/src/calculation/scope3_engine.py apps/site-api/src/calculation/scope12_batch.py ./apps/site-api/src/calculation/
COPY packages/neuvetra-database/src/collection.ts packages/neuvetra-database/src/collection-contract.ts packages/neuvetra-database/src/collection-engine-input.ts packages/neuvetra-database/src/collection-duplicates.ts packages/neuvetra-database/src/method-reference.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/scope3-collection-contract.ts packages/neuvetra-database/src/scope3-collection.ts packages/neuvetra-database/src/scope3-coverage.ts packages/neuvetra-database/src/scope3-engine-output.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-01: the method catalog and texts used by the coverage boundary and the results route, and the
# per-company results scheduler both results routes import (missing from the image since it was added).
COPY packages/neuvetra-database/src/scope3-method-catalog.ts packages/neuvetra-database/src/scope3-text.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/results-scheduler.ts ./apps/site-api/src/workspace/
# Scope 3 completion I-02: the assessment contract (scope3-text.ts is copied once, above).
COPY packages/neuvetra-database/src/scope3-assessment-contract.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-04: category assessments (database access and route).
COPY packages/neuvetra-database/src/scope3-assessments.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/scope3-assessment-routes.ts ./apps/site-api/src/workspace/
# Scope 3 completion I-09: spend CSV import (shared parser, database access and route).
COPY packages/neuvetra-database/src/scope3-spend-import.ts packages/neuvetra-database/src/scope3-spend-imports.ts packages/neuvetra-database/src/scope3-spend-grouping.ts packages/neuvetra-database/src/scope3-spend-currency.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/scope3-spend-import-routes.ts ./apps/site-api/src/workspace/
# Scope 3 completion I-06: the line trace and profile checks (boundary and results route) and the methodology statement.
COPY packages/neuvetra-database/src/scope3-trace.ts packages/neuvetra-database/src/scope3-methodology.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-10: frozen report versions: the document and database modules, the route, the shared CSV (and the
# deadline it states), and the CSV label functions, so a stored CSV is the bytes the Results screen would download.
COPY packages/neuvetra-database/src/scope3-report-document.ts packages/neuvetra-database/src/scope3-reports.ts packages/neuvetra-database/src/scope3-report-csv.ts packages/neuvetra-database/src/scope3-deadline.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/scope3-report-routes.ts ./apps/site-api/src/workspace/
# Round 2 (lane B): the frozen report validators (owner decision 11) and the shared Scope 3 route helpers (ENG-14).
COPY packages/neuvetra-database/src/scope3-report-v1.ts packages/neuvetra-database/src/scope3-report-v2.ts ./packages/neuvetra-database/src/
COPY packages/neuvetra-database/src/scope3-report-v3.ts packages/neuvetra-database/src/scope3-text-v3.ts ./packages/neuvetra-database/src/
COPY apps/site-api/src/workspace/scope3-route-helpers.ts ./apps/site-api/src/workspace/
# Round 2 lane E (ENG-6): the CSV label functions live in the package (the API no longer imports web source).
COPY packages/neuvetra-database/src/plain-language-labels.ts packages/neuvetra-database/src/scope3-text-r2e.ts ./packages/neuvetra-database/src/
# Round 3 lane A: the shared memo, partial-boundary and superseded-spend helpers (adapter, coverage, results route, CSV).
COPY packages/neuvetra-database/src/scope3-r3a.ts ./packages/neuvetra-database/src/
# Scope 3 completion I-03: R2, the spend register the Scope 3 engine pins (EPA Supply Chain GHG Emission Factors v1.3).
COPY packages/neuvetra-database/src/method-reference/verified-scope3-spend-register-epa-scghg-v1.3.json ./packages/neuvetra-database/src/method-reference/
# Scope 3 completion I-05: R3, the supplement register the Scope 3 engine pins (Hub 2025 Tables 1, 11, 12; eGRID2023 rev2).
COPY packages/neuvetra-database/src/method-reference/verified-scope3-supplement-register-2025.json ./packages/neuvetra-database/src/method-reference/
# Scope 3 completion I-12u: R5, the US upstream register the Scope 3 engine pins (NETL natural gas, CA-GREET3.0, CARB LCFS energy densities).
COPY packages/neuvetra-database/src/method-reference/verified-scope3-us-upstream-register-2025.json ./packages/neuvetra-database/src/method-reference/
# Scope 3 completion I-12h: R6, the building and hotel register the Scope 3 engine pins (CBECS 2018 C14/C24; EPA events guidance 2018 Table 5).
COPY packages/neuvetra-database/src/method-reference/verified-scope3-us-building-hotel-register-2025.json ./packages/neuvetra-database/src/method-reference/
COPY packages/neuvetra-database/src/method-reference/verified-factor-register-2025.json packages/neuvetra-database/src/method-reference/verified-electricity-register-egrid2023.json packages/neuvetra-database/src/method-reference/verified-electricity-register-egrid2023-greene2025.json packages/neuvetra-database/src/method-reference/verified-scope3-register-2025.json packages/neuvetra-database/src/method-reference/egrid2023-zip-subregion-utility.csv ./packages/neuvetra-database/src/method-reference/
COPY packages/neuvetra-database/src/migrations/0024_method_reference.sql packages/neuvetra-database/src/migrations/0025_scope3_method_reference.sql packages/neuvetra-database/src/migrations/0026_scope2_residual_mix.sql packages/neuvetra-database/src/migrations/0027_collection.sql packages/neuvetra-database/src/migrations/0028_collection_zip_check.sql packages/neuvetra-database/src/migrations/0029_scope3_collection.sql packages/neuvetra-database/src/migrations/0030_scope3_completion.sql packages/neuvetra-database/src/migrations/0031_integrity_guards.sql ./packages/neuvetra-database/src/migrations/
# Import and hash verification happen without credentials or network calls.
RUN bun --version && python --version && bun -e 'await import("./apps/site-api/src/staging/server.ts"); const {verifyStagingAssets}=await import("./apps/site-api/src/staging/assets.ts"); await verifyStagingAssets("/app/apps/site-web/dist-staging");'
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=20s --start-period=30s --retries=3 CMD ["bun", "-e", "const r=await fetch('http://127.0.0.1:'+(process.env.PORT||'8080')+'/ready',{signal:AbortSignal.timeout(18000)});process.exit(r.ok?0:1)"]
CMD ["bun", "run", "apps/site-api/src/staging/server.ts"]
