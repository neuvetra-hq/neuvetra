# Default: force LF line endings for text files
# Prevents Windows CRLF phantom diffs across machines
* text=auto eol=lf

# Explicit text files
*.md          text eol=lf
*.json        text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.sql         text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sh          text eol=lf

# Windows scripts keep CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.svg         binary
*.pdf         binary
*.zip         binary
*.tar.gz      binary
*.tgz         binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary
*.otf         binary
*.mp3         binary
*.mp4         binary
*.wav         binary

# Lock files — text but never auto-normalize (let Bun/npm own line endings)
bun.lock      -text
package-lock.json -text
